<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:elevation="3dp"
        android:paddingLeft="20dp"
        android:paddingRight="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ИНВЕНТАРИЗАЦИЯ"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:textColor="@color/primary"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvInvSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/secondary"
                android:layout_marginTop="1dp"
                android:text="Подключение…"/>
        </LinearLayout>

        <!-- Scan-count mode indicator -->
        <TextView
            android:id="@+id/tvScanMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ПИКАТЬ"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:textStyle="bold"
            android:textColor="@color/on_primary"
            android:background="#FF5722"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"/>

        <!-- Hamburger -->
        <TextView
            android:id="@+id/tvHamburger"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="≡"
            android:textSize="22sp"
            android:gravity="center"
            android:textColor="@color/on_background"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>

    <!-- Stats row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_bg"
            android:padding="8dp"
            android:layout_marginRight="4dp">
            <TextView
                android:id="@+id/tvStatTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="всего"
                android:textSize="10sp"
                android:textColor="@color/secondary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_bg"
            android:padding="8dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp">
            <TextView
                android:id="@+id/tvStatMatched"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/success"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ок"
                android:textSize="10sp"
                android:textColor="@color/secondary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_bg"
            android:padding="8dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp">
            <TextView
                android:id="@+id/tvStatPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/warning"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="проверка"
                android:textSize="10sp"
                android:textColor="@color/secondary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_bg"
            android:padding="8dp"
            android:layout_marginLeft="4dp">
            <TextView
                android:id="@+id/tvStatDisc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/error"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="расхожд"
                android:textSize="10sp"
                android:textColor="@color/secondary"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Scan-count panel (shown only in scan-count mode) -->
    <LinearLayout
        android:id="@+id/panelScanCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:elevation="3dp"
        android:padding="16dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCountBarcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/secondary"
            android:text="штрихкод"/>

        <TextView
            android:id="@+id/tvCountProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/on_background"
            android:layout_marginTop="2dp"
            android:text="Сканируйте товар"/>

        <TextView
            android:id="@+id/tvCountStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/secondary"
            android:layout_marginTop="2dp"
            android:text=""/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvCountQty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/primary"/>

            <Button
                android:id="@+id/btnCountConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Подтвердить"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/primary"/>

            <Button
                android:id="@+id/btnCountCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сброс"
                android:textAllCaps="false"
                android:textColor="@color/error"
                android:backgroundTint="@color/background"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Buffer (shown in manual mode) -->
    <LinearLayout
        android:id="@+id/panelBuffer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_bg"
        android:elevation="2dp"
        android:paddingLeft="18dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvInvBuffer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:hint="ожидание сканирования…"
            android:textColorHint="@color/secondary"/>
    </LinearLayout>

    <!-- List label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ПОСЛЕДНИЕ СКАНИРОВАНИЯ"
        android:textSize="10sp"
        android:textColor="@color/secondary"
        android:letterSpacing="0.1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_marginBottom="6dp"/>

    <!-- Scan list -->
    <ScrollView
        android:id="@+id/svInvList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <LinearLayout
            android:id="@+id/llInvList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp"/>
    </ScrollView>

</LinearLayout>
